<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="0">
      <solid android:color="#FF00B7F4"/>
    </shape>
  </item>
  <item android:state_focused="true" android:state_activated="true">
    <shape android:shape="0">
      <stroke android:width="3.000000px" android:color="#FF00B7F4"/>
      <solid android:color="#FF56647B"/>
    </shape>
  </item>
  <item android:state_activated="true">
    <shape android:shape="0">
      <solid android:color="#FF56647B"/>
    </shape>
  </item>
  <item android:state_focused="true">
    <shape android:shape="0">
      <stroke android:width="3.000000px" android:color="#FF00B7F4"/>
    </shape>
  </item>
  <item>
    <shape android:shape="0">
      <solid android:color="#FF3D414F"/>
    </shape>
  </item>
</selector>
