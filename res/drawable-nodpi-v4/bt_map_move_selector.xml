<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="#26FFFFFF"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0204C1"/>
      </item>
    </layer-list>
  </item>
  <item android:state_focused="true">
    <layer-list>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0204B2"/>
      </item>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0204C1"/>
      </item>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="@android:0106000D"/>
          <stroke android:width="@7F090111" android:color="#33FFFFFF"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:state_enabled="false">
    <layer-list>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0204B2"/>
      </item>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0204C1"/>
      </item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0204B2"/>
      </item>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0204C1"/>
      </item>
    </layer-list>
  </item>
</selector>
