<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item>
        <nine-patch android:gravity="0x00000073" android:src="@7F02037D"/>
      </item>
      <item android:left="1.000000px">
        <shape android:shape="rectangle">
          <solid android:color="#33000033"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:state_focused="true">
    <layer-list>
      <item>
        <nine-patch android:gravity="0x00000073" android:src="@7F02037D"/>
      </item>
      <item android:left="1.000000px">
        <shape android:shape="rectangle">
          <solid android:color="#1AFFFFFF"/>
          <stroke android:width="3.000000px" android:color="#33000033"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="#1AFFFFFF"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
      <item>
        <nine-patch android:gravity="0x00000073" android:src="@7F02037D"/>
      </item>
    </layer-list>
  </item>
</selector>
