<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item>
        <shape android:shape="0">
          <solid android:color="#40FFFFFF"/>
          <stroke android:width="1.000000px" android:color="#30FFFFFF"/>
          <corners android:radius="12.000000px"/>
        </shape>
      </item>
      <item android:bottom="20.000000px">
        <shape android:shape="0">
          <gradient android:startColor="#20FFFFFF" android:endColor="#00FFFFFF" android:angle="270.000000"/>
          <corners android:radius="12.000000px"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item>
        <shape android:shape="0">
          <solid android:color="#22FFFFFF"/>
          <stroke android:width="1.000000px" android:color="#15FFFFFF"/>
          <corners android:radius="12.000000px"/>
        </shape>
      </item>
      <item android:bottom="20.000000px">
        <shape android:shape="0">
          <gradient android:startColor="#10FFFFFF" android:endColor="#00FFFFFF" android:angle="270.000000"/>
          <corners android:radius="12.000000px"/>
        </shape>
      </item>
    </layer-list>
  </item>
</selector>
