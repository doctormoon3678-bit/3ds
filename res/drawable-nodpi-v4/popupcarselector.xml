<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="#26FFFFFF"/>
      <corners android:radius="12dp"/>
        </shape>
  </item>
  <item android:state_focused="true" android:state_selected="false">
    <shape android:shape="rectangle">
      <solid android:color="@android:0106000D"/>
      <stroke android:width="2.000000px" android:color="#33000033"/>
      <corners android:radius="12dp"/>
        </shape>
  </item>
  <item android:state_focused="true" android:state_selected="true">
    <layer-list>
      <item>
        <bitmap android:gravity="0x00000011" android:src="@7F0203EC"/>
      </item>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="@android:0106000D"/>
          <stroke android:width="2.000000px" android:color="#33000033"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="#26FFFFFF"/>
      <corners android:radius="12dp"/>
        </shape>
  </item>
  <item android:state_selected="true" android:drawable="@7F0203EC"/>
  <item android:state_enabled="true">
    <shape android:shape="rectangle">
      <solid android:color="@android:0106000D"/>
      <corners android:radius="12dp"/>
        </shape>
  </item>
</selector>
