<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="#FF0A84FF"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:state_focused="true">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="#00000000"/>
          <stroke android:width="4.000000px" android:color="#FF0A84FF"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:state_selected="true">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="#00000000"/>
          <stroke android:width="4.000000px" android:color="#FF0A84FF"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item android:state_enabled="false">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="#00000000"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item>
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="#00000000"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
      <item android:left="18.000000px" android:top="77.000000px" android:right="18.000000px">
        <shape android:shape="2">
          <stroke android:width="1.000000px" android:color="@7F08001C"/>
          <corners android:radius="12dp"/>
        </shape>
      </item>
    </layer-list>
  </item>
</selector>
